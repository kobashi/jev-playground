# Required. Issued from the TypeSafe AI console.
TYPESAFE_API_KEY=

# Optional. Defaults to jev-latest.
# TYPESAFE_DEFAULT_MODEL=jev-latest

# Optional. Defaults to https://api.typesafe.ai.
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# Optional. off | error | warn | info | debug. Defaults to warn.
# TYPESAFE_LOG_LEVEL=warn

# Optional. Per-attempt timeout in milliseconds. Defaults to 10000.
# JEV_TIMEOUT_MS=10000
